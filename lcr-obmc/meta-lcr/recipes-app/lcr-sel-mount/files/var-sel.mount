[Unit]
Description=Mount qspi-sel (mtd5) JFFS2 for persistent IPMI SEL storage
DefaultDependencies=no
After=local-fs-pre.target systemd-tmpfiles-setup.service
Before=rsyslog.service xyz.openbmc_project.Logging.service sel-logger.service

[Mount]
What=/dev/mtdblock5
Where=/var/sel
Type=jffs2
Options=rw,noatime

[Install]
WantedBy=local-fs.target

[ExecStartPost]
ExecStartPost=/bin/ln -sf /var/sel/ipmi_sel /var/log/ipmi_sel
