[Unit]
Description=Mount qspi-persistent (mtd7) JFFS2 for miscellaneous persistent storage
DefaultDependencies=no
After=local-fs-pre.target systemd-tmpfiles-setup.service
Before=rsyslog.service xyz.openbmc_project.Logging.service sel-logger.service

[Mount]
What=/dev/mtdblock7
Where=/var/persistent
Type=jffs2
Options=rw,noatime

[Install]
WantedBy=local-fs.target
